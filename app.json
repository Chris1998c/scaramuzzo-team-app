{
  "expo": {
    "name": "Scaramuzzo Team",
    "slug": "team-app",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "teamapp",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "package": "green.scaramuzzo.team",
      "adaptiveIcon": {
        "backgroundColor": "#140905",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "ACCESS_COARSE_LOCATION",
        "ACCESS_FINE_LOCATION",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION"
      ]
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png",
      "name": "Scaramuzzo Team",
      "shortName": "Scaramuzzo Team",
      "description": "Presenze, agenda e statistiche per i collaboratori Scaramuzzo",
      "themeColor": "#140905",
      "backgroundColor": "#140905",
      "display": "standalone",
      "lang": "it",
      "startUrl": "/team",
      "scope": "/team"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#140905",
          "dark": {
            "backgroundColor": "#140905"
          }
        }
      ],
      "expo-secure-store",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Scaramuzzo usa la posizione solo per verificare la timbratura in salone.",
          "locationAlwaysAndWhenInUsePermission": "Scaramuzzo usa la posizione solo per verificare la timbratura in salone."
        }
      ],
      "expo-font",
      "expo-image",
      "expo-web-browser",
      "expo-status-bar"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true,
      "baseUrl": "/team"
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "7445e35f-d1da-4629-b353-5ad52dcc91ab"
      }
    },
    "owner": "chris1998"
  }
}
