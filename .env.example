# URL base del gestionale Scaramuzzo Manager (obbligatorio).
# Copia questo file in `.env` e imposta il valore per il tuo ambiente.
#
# Sviluppo locale (es. Manager su porta 3000):
# EXPO_PUBLIC_API_BASE_URL=http://127.0.0.1:3000
#
# Pilota / produzione:
# EXPO_PUBLIC_API_BASE_URL=https://manager.example.com

EXPO_PUBLIC_API_BASE_URL=
